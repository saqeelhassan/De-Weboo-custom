# Security & performance defaults (Apache)
Options -Indexes

<IfModule mod_dir.c>
    DirectoryIndex index.php index.html
</IfModule>

# Clean URLs: hide the .php extension
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Canonical redirects run before internal routing. THE_REQUEST avoids loops.
    # Only production hosts are forced to HTTPS, so local development still works.
    RewriteCond %{HTTP_HOST} ^(?:www\.)?deweboo\.com$ [NC]
    RewriteCond %{THE_REQUEST} \s/+index\.php[\s?] [NC]
    RewriteRule ^index\.php$ https://deweboo.com/ [R=301,L,NE]

    RewriteCond %{HTTP_HOST} ^(?:www\.)?deweboo\.com$ [NC]
    RewriteRule ^seo-services(?:\.php)?/?$ https://deweboo.com/seo [R=301,L,NE]

    RewriteCond %{HTTP_HOST} ^(?:www\.)?deweboo\.com$ [NC]
    RewriteRule ^digital-wedding-card(?:\.php)?/?$ https://deweboo.com/services/digital-wedding-card [R=301,L,NE]

    RewriteCond %{HTTP_HOST} ^(?:www\.)?deweboo\.com$ [NC]
    RewriteCond %{REQUEST_URI} !^/(?:handlers|tools|includes)/ [NC]
    RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
    RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.php[\s?] [NC]
    RewriteRule ^ https://deweboo.com/%1 [R=301,L,NE]

    RewriteCond %{HTTP_HOST} ^(?:www\.)?deweboo\.com$ [NC]
    RewriteCond %{HTTP_HOST} ^www\. [NC,OR]
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://deweboo.com%{REQUEST_URI} [R=301,L,NE]

    RewriteRule ^seo-services/?$ /seo [R=301,L]
    RewriteRule ^digital-wedding-card/?$ /services/digital-wedding-card [R=301,L]
    RewriteRule ^sitemap\.xml$ sitemap.php [L]

    # Internal build tools must not be publicly callable.
    RewriteRule ^tools/ - [F,L]

    # Legacy .html URLs → clean URL (after migration)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+)\.html$ $1 [R=301,L]

    # Never touch AJAX/handler endpoints — they must keep their real .php path
    RewriteRule ^handlers/ - [L]

    # Removed page: /collaboration -> /contact
    RewriteRule ^collaboration/?$ /contact [R=301,L]

    # Canonicalize: /page.php -> /page (skip POST so form/AJAX submissions aren't redirected)
    RewriteCond %{REQUEST_METHOD} GET
    RewriteCond %{THE_REQUEST} \s/+index\.php[\s?] [NC]
    RewriteRule ^ / [R=301,L]

    RewriteCond %{REQUEST_METHOD} GET
    RewriteCond %{THE_REQUEST} \s/+(.+)\.php[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L]

    RewriteRule ^services/digital-wedding-card/?$ digital-wedding-card.php [L,QSA]

    # Pretty detail routes
    RewriteRule ^blog/([^/]+)/?$ blog-details.php?post=$1 [L,QSA]
    RewriteRule ^portfolio/([^/]+)/?$ portfolio-details.php?project=$1 [L,QSA]
    RewriteRule ^team/([^/]+)/?$ team-details.php?member=$1 [L,QSA]

    # Internally serve /page as page.php when the clean URL has no matching file/dir
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^(.*)$ $1.php [L]
</IfModule>

# Block access to configuration and one-off build tooling
<FilesMatch "^(config\.php|build-.*\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(?:css|js|webp|avif|png|jpe?g|svg|woff2?)$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>
    # Content-hashed bundles have immutable URLs.
    <FilesMatch "\.[a-f0-9]{12}\.(?:css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
